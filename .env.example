NODE_ENV=development
PORT=3000

# Database (Default host port 5433 prevents collisions with native local PostgreSQL on 5432)
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5433
DB_NAME=app_dev
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/app_dev?schema=public"

# Redis (Cache-aside and distributed rate limiting)
REDIS_HOST=localhost
REDIS_PORT=6379